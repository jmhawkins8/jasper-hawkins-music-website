{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/song-list",
      "destination": "/songlist",
      "permanent": true
    },
    {
      "source": "/weddings-2025",
      "destination": "/weddings",
      "permanent": true
    },
    {
      "source": "/weddings-copy",
      "destination": "/weddings",
      "permanent": true
    },
    {
      "source": "/weddings-off-peak",
      "destination": "/weddings",
      "permanent": true
    },
    {
      "source": "/wedding-guide",
      "destination": "/weddings",
      "permanent": true
    },
    {
      "source": "/wedding-celebrant",
      "destination": "/weddings",
      "permanent": true
    },
    {
      "source": "/faqs",
      "destination": "/weddings",
      "permanent": true
    },
    {
      "source": "/party-band",
      "destination": "/parties",
      "permanent": true
    },
    {
      "source": "/party-band-for-hire",
      "destination": "/parties",
      "permanent": true
    },
    {
      "source": "/parties-old-page",
      "destination": "/parties",
      "permanent": true
    },
    {
      "source": "/video",
      "destination": "/songlist",
      "permanent": true
    },
    {
      "_comment": "TEMPORARY on purpose. Jasper intends to rebuild this page at this same URL for his own music. A 301 would tell Google the address is gone for good; a 302 keeps its identity so removing this line later restores it with its history.",
      "source": "/making-the-music",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/spring-promotion",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/march-promotion",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/march-april-special",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
